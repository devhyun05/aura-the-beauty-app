{
  "name": "@aura/report-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "npm --prefix ../../packages/face-report-contract run test && node --experimental-strip-types --test test/*.test.ts",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host 127.0.0.1"
