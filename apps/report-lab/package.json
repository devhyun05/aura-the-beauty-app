  "dependencies": {
    "@aura/face-report-contract": "file:../../packages/face-report-contract",
    "@phosphor-icons/react": "^2.1.10",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "5.0.4",
    "typescript": "^6.0.3",
    "vite": "6.4.2"
  }
}
