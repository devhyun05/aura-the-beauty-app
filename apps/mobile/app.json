{
  "expo": {
    "name": "AURA",
    "slug": "ai-ar-makeup-guide",
    "version": "0.1.0",
    "orientation": "portrait",
    "platforms": [
      "ios"
    ],
    "scheme": "aiarmakeup",
    "userInterfaceStyle": "light",
    "extra": {
      "router": {
        "root": "app"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aiarmakeupguide.mobile",
      "appleTeamId": "WSLFBT6QHB"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "AURA 얼굴 촬영과 AR 메이크업 기능을 위해 카메라 접근 권한이 필요합니다."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AURA 사진 업로드와 분석 기능을 위해 사진 보관함 접근 권한이 필요합니다."
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      [
        "expo-media-library",
        {
          "photosPermission": "AURA 보고서 이미지 저장을 위해 사진 보관함 접근 권한이 필요합니다.",
          "savePhotosPermission": "AURA 추천 메이크업 이미지를 사진 앱에 저장하기 위해 권한이 필요합니다.",
          "preventAutomaticLimitedAccessAlert": true,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "expo-sharing"
    ]
  }
}
