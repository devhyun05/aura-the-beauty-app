{
  "expo": {
    "name": "AURA",
    "slug": "ai-ar-makeup-guide",
    "version": "1.1.0",
    "orientation": "portrait",
    "platforms": [
      "ios",
      "android"
    ],
    "scheme": "aiarmakeup",
    "userInterfaceStyle": "light",
    "extra": {
      "router": {
        "root": "app"
      },
      "eas": {
        "projectId": "93feec85-77bc-481c-bc28-142f56db9782"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aurastyleguide.mobile",
      "appleTeamId": "BRA7W3G4QS",
      "usesAppleSignIn": true,
      "infoPlist": {
        "NSMotionUsageDescription": "AURA AR 메이크업 기능에서 기기의 움직임에 맞춰 카메라와 그래픽을 안정적으로 표시하기 위해 동작 센서 정보가 필요합니다.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "AURA 얼굴 촬영, AR 메이크업, 퍼스널 컬러(피부·헤어·입술 색) 분석 기능을 위해 카메라 접근 권한이 필요합니다. 퍼스널 컬러 분석은 기기 내에서만 처리됩니다."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AURA 사진 업로드와 분석 기능을 위해 사진 보관함 접근 권한이 필요합니다."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "AURA가 현재 위치 주변의 네이버 뷰티샵을 보여주고 지역 날씨 기반 요즘 트렌드 제품을 추천하기 위해 위치 접근 권한이 필요합니다."
        }
      ],
      "expo-web-browser",
      "expo-secure-store",
      "expo-notifications",
      [
        "expo-media-library",
        {
          "photosPermission": "AURA 보고서 이미지 저장을 위해 사진 보관함 접근 권한이 필요합니다.",
          "savePhotosPermission": "AURA 추천 메이크업 이미지를 사진 앱에 저장하기 위해 권한이 필요합니다.",
          "preventAutomaticLimitedAccessAlert": true,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      "expo-sharing"
    ],
    "owner": "devhyun05"
  }
}
