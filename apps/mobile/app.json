{
  "expo": {
    "name": "AURA",
    "slug": "ai-ar-makeup-guide",
    "version": "0.1.0",
    "orientation": "portrait",
    "platforms": [
      "ios"
    ],
    "scheme": "aiarmakeup",
    "userInterfaceStyle": "light",
    "extra": {
      "router": {
        "root": "app"
      }
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.aiarmakeupguide.mobile.seojin",
      "appleTeamId": "5947QNM627"
    },
    "plugins": [
      "expo-status-bar",
      [
        "expo-camera",
        {
          "cameraPermission": "AURA 얼굴 촬영과 AR 메이크업 기능을 위해 카메라 접근 권한이 필요합니다."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "AURA 사진 업로드와 분석 기능을 위해 사진 보관함 접근 권한이 필요합니다."
        }
      ],
      "expo-web-browser",
      "expo-secure-store"
    ]
  }
}
