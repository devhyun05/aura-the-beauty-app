# Required for Cognito Hosted UI login.
EXPO_PUBLIC_COGNITO_CLIENT_ID=

# Use either EXPO_PUBLIC_COGNITO_DOMAIN or DOMAIN_PREFIX + REGION.
# Example full domain: https://your-domain.auth.ap-northeast-2.amazoncognito.com
EXPO_PUBLIC_COGNITO_DOMAIN=
EXPO_PUBLIC_COGNITO_DOMAIN_PREFIX=
EXPO_PUBLIC_COGNITO_REGION=ap-northeast-2

# Expo Go usually needs the exp://.../--/auth/callback URL that AuthSession prints at runtime.
# Development/standalone builds can use aiarmakeup://auth/callback.
EXPO_PUBLIC_COGNITO_REDIRECT_URI=aiarmakeup://auth/callback

EXPO_PUBLIC_COGNITO_SCOPES=openid email profile
# Optional. Leave blank for smoother repeat login; set select_account only when you need the account picker every time.
EXPO_PUBLIC_COGNITO_PROMPT=

# Match these with the IdP names configured in your Cognito user pool.
EXPO_PUBLIC_COGNITO_GOOGLE_IDP=Google
EXPO_PUBLIC_COGNITO_KAKAO_IDP=Kakao
EXPO_PUBLIC_COGNITO_NAVER_IDP=Naver

# Optional. When set, login syncs Cognito user info with FastAPI /users/me.
# Use a LAN IP for local device testing, for example http://192.168.0.10:8000/api.
# Use https://<cloudfront-domain>/api for deployed builds.
EXPO_PUBLIC_API_BASE_URL=

# Optional. Set true to request Bedrock reference makeup extraction; false keeps the deterministic fallback.
EXPO_PUBLIC_REFERENCE_MAKEUP_AI_ENABLED=false

# QA/DEMO ONLY — leave blank. When set (and only in __DEV__ builds), the app boots straight into
# AURADIN search and auto-drives search→detail→dial. NEVER set this for on-device test builds:
# it hijacks the home screen and hides the real user flow. Simulator demos only.
EXPO_PUBLIC_AURADIN_DEMO_DRIVE=
