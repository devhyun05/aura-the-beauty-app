APP_NAME="AI AR Makeup Backend"
ENVIRONMENT=local
DEBUG=false
API_PREFIX=/api

DATABASE_URL=
# Host port used only by docker-compose.yml; override when 5432 is occupied.
AURA_POSTGRES_PORT=5432
# Optional alternative to DATABASE_URL for RDS-managed passwords.
# When set, the backend reads username/password from Secrets Manager.
DATABASE_SECRET_ID=
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_SSLMODE=require

# Keep true whenever multiple people or a shared database use this backend.
# false maps every request to the single DEV_USER_* identity.
AUTH_REQUIRED=true
DEV_USER_SUB=local-dev-user
DEV_USER_EMAIL=dev@example.com
DEV_USER_NAME="Local Dev"

AWS_REGION=ap-northeast-2
AWS_PROFILE_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_USE_IAM_ROLE=false

AI_PROVIDER=bedrock
IMAGE_GENERATION_PROVIDER=openai
# Keep inline for local development. Set sqs after the ECS worker and queue are deployed.
AI_JOB_EXECUTION_MODE=inline
SQS_AI_JOB_QUEUE_URL=
# Emergency API kill switch for the MakeupJourney rollout.
MAKEUP_JOURNEY_ENABLED=true
MAKEUP_RECOMMENDATION_V2_ENABLED=true
MAKEUP_TREND_KEYWORDS_ENABLED=true
MAKEUP_PERSONALIZED_IMAGE_ENABLED=true
MAKEUP_RECOMMENDATION_V1_COMPAT_ENABLED=true
# Opt-in staged S1 + Face3D analysis. Requests without the v1 measurement schema
# continue through the legacy single-pass analyzer.
FACE_ANALYSIS_V2_ENABLED=true
FACE_ANALYSIS_STAGE_TIMEOUT_SECONDS=130
FACE_ANALYSIS_STAGE_MAX_ATTEMPTS=2
# Phase 4 population norm activation is intentionally OFF. Do not populate the
# registry/approval fields until a self-selected-locale dataset and product-owner
# approval artifact exist and their hashes have been independently reviewed.
FACE_LENGTH_NORM_ENABLED=false
FACE_LENGTH_NORM_REGISTRY_PATH=
FACE_LENGTH_NORM_APPROVAL_ARTIFACT_SHA256=

OPENAI_ENABLED=true
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_ANALYSIS_MODEL_ID=global.anthropic.claude-sonnet-4-6
# One high-reasoning Bedrock call per report. The legacy evidence pipeline is
# intentionally off because it performs two additional model invocations.
MAKEUP_FEEDBACK_EVIDENCE_PIPELINE_ENABLED=false
MAKEUP_FEEDBACK_COMPACT_SINGLE_CALL_ENABLED=true
MAKEUP_FEEDBACK_CONFERENCE_PREVIEW_AI_ENABLED=false
MAKEUP_FEEDBACK_CONFERENCE_AI_ENABLED=false
MAKEUP_FEEDBACK_ADAPTIVE_THINKING_ENABLED=false
MAKEUP_FEEDBACK_REASONING_EFFORT=high
# Global inference has no geographic processing restriction. Set true only
# after the deployment owner accepts that routing behavior.
MAKEUP_FEEDBACK_GLOBAL_INFERENCE_ALLOWED=false
# ap-northeast-2에서 이 모델은 on-demand invoke 불가 — cross-region inference profile 필수.
BEDROCK_ANALYSIS_INFERENCE_ID=
BEDROCK_ANALYSIS_REGION=ap-northeast-2
BEDROCK_SCENARIO_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_QUESTION_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
BEDROCK_RECOMMENDATION_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0
# Local SSO/profile credential resolution can take a few seconds. Keep this
# bounded so /health/ready still returns when a provider chain hangs.
BEDROCK_CREDENTIAL_READINESS_TIMEOUT_SECONDS=5
BEDROCK_GUARDRAIL_ID=xxe1xkbvyg34
BEDROCK_GUARDRAIL_VERSION=4
BEDROCK_GUARDRAIL_REGION=ap-northeast-2
BEDROCK_GUARDRAIL_REQUIRED=true
BEDROCK_GUARDRAIL_TRACE=false
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_REGION=ap-northeast-2
EMBEDDING_DIMENSION=1024

# Auradin search agent. `auto` uses a persisted embedding vector index when one
# exists and falls back to lexical search. Set `embedding` to require vector
# search. Set `AURADIN_SESSION_STORE=postgres` with DATABASE_URL to persist
# search sessions across backend restarts.
AURADIN_RETRIEVAL_BACKEND=auto
AURADIN_VECTOR_INDEX_PATH=
AURADIN_VECTOR_INDEX_AUTOBUILD=false
AURADIN_SESSION_STORE=postgres
AURADIN_SESSION_TTL_SECONDS=900

COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_ID=

S3_BUCKET_NAME=
# Sensitive face/feedback/extraction images must use a bucket that is not a
# CloudFront origin. The backend fails closed outside local/test when omitted.
PRIVATE_MEDIA_BUCKET_NAME=
PRIVATE_MEDIA_URL_TTL_SECONDS=300
CLOUDFRONT_DOMAIN=
CDN_BASE_URL=
OPENAI_API_KEY=
OPENAI_ANALYSIS_MODEL_ID=gpt-5.5
OPENAI_IMAGE_MODEL_ID=gpt-image-2
OPENAI_IMAGE_QUALITY=low
OPENAI_IMAGE_SIZE=1024x1536
OPENAI_IMAGE_OUTPUT_FORMAT=jpeg
OPENAI_IMAGE_OUTPUT_COMPRESSION=90
OPENAI_IMAGE_INPUT_MAX_EDGE=1024
OPENAI_IMAGE_INPUT_QUALITY=82
OPENAI_IMAGE_OUTPUT_MAX_EDGE=1536
MAKEUP_PRIVATE_ASSET_PREFIX=private/generated-makeup-recommendations
MAKEUP_PRIVATE_URL_TTL_SECONDS=900

# Expo Push Service (iOS uses APNs through Expo; Firebase is not required).
PUSH_NOTIFICATIONS_ENABLED=true
EXPO_PUSH_ENDPOINT=https://exp.host/--/api/v2/push/send
# Optional when Expo Push Security is enabled for the EAS project.
EXPO_PUSH_ACCESS_TOKEN=

HAIR_JOBS_QUEUE_URL=
HAIR_STYLE_ASSET_BUCKET=
HAIR_STYLE_ASSET_PREFIX=catalog/hair-styles/v1
HAIR_STYLE_ASSETS_REQUIRE_APPROVAL=true
HAIR_SOURCE_RETENTION_HOURS=24
HAIR_SIMULATIONS_PER_ANALYSIS=3
HAIR_SIMULATIONS_PER_DAY=6
HAIR_WORKER_WAIT_TIME_SECONDS=20
HAIR_WORKER_VISIBILITY_TIMEOUT_SECONDS=360
HAIR_WORKER_REQUEST_TIMEOUT_SECONDS=180
HAIR_GENERATION_QUALITY=medium
HAIR_SEGMENTER_MODEL_PATH=/app/models/hair_segmenter.tflite

# Naver Shopping discovery credentials. Search results are never ingested as a
# licensed catalog. Makeup-report snapshots use them as live candidates and
# keep only items that pass the server-side listing/image evidence contract.
NAVER_SHOPPING_CLIENT_ID=
NAVER_SHOPPING_CLIENT_SECRET=
MAKEUP_REPORT_SHADOW_PALETTE_MAX_DELTA_E=26
NAVER_API_HUB_CLIENT_ID=
NAVER_API_HUB_CLIENT_SECRET=

# Product recommendation V2. Data-backed sections still stay honestly empty
# until a signed, rights-valid manifest is imported.
PRODUCT_HUB_V2=true
SEASONAL_RECOMMENDATIONS_V1=true
AR_RECIPE_PERSISTENCE_V1=true
AR_PRODUCT_RECOMMENDATIONS_V1=true
ENGAGEMENT_PERSONALIZATION_V1=false
COHORT_RECOMMENDATIONS_V1=false
LEGACY_NAVER_PRODUCT_SEARCH=false
NAVER_SHOPPING_INSIGHT_ENABLED=false
NAVER_SHOPPING_INSIGHT_ENDPOINT=https://openapi.naver.com/v1/datalab/shopping/category/keywords
NAVER_SEARCH_TREND_ENDPOINT=https://openapi.naver.com/v1/datalab/search
NAVER_TREND_CONTENT_ENABLED=false
NAVER_TREND_NEWS_ENDPOINT=https://openapi.naver.com/v1/search/news.json
NAVER_TREND_BLOG_ENDPOINT=https://openapi.naver.com/v1/search/blog.json
NAVER_TREND_CAFE_ENDPOINT=https://openapi.naver.com/v1/search/cafearticle.json
NAVER_TREND_CONTENT_INTERVAL_HOURS=3
NAVER_TREND_VALIDATION_INTERVAL_HOURS=12
NAVER_TREND_CONTENT_MAX_SEED_QUERIES=1
NAVER_TREND_MONTHLY_CALL_LIMIT=3000
NAVER_TREND_HTTP_TIMEOUT_SECONDS=5
NAVER_TREND_HTTP_MAX_ATTEMPTS=2
PRODUCT_TREND_BURST_MIN_DOCUMENTS=5
PRODUCT_TREND_BURST_MIN_SOURCES=2
PRODUCT_TREND_BURST_MIN_Z_SCORE=2.5
KMA_WEATHER_ENABLED=false
KMA_WEATHER_ENDPOINT=https://apis.data.go.kr/1360000/VilageFcstInfoService_2.0/getVilageFcst
KMA_WEATHER_SERVICE_KEY=
KMA_WEATHER_INTERVAL_HOURS=3
KMA_WEATHER_MONTHLY_CALL_LIMIT=10000
KMA_WEATHER_HTTP_TIMEOUT_SECONDS=5
PRODUCT_TREND_BEDROCK_ENABLED=false
PRODUCT_TREND_BEDROCK_MODEL_ID=
PRODUCT_TREND_BEDROCK_DAILY_CALL_LIMIT=1
PRODUCT_TREND_BEDROCK_MONTHLY_CALL_LIMIT=31
PRODUCT_TREND_BEDROCK_INPUT_TOKEN_LIMIT=8000
PRODUCT_TREND_BEDROCK_OUTPUT_TOKEN_LIMIT=800
PRODUCT_TREND_BEDROCK_TIMEOUT_SECONDS=12
TREND_NOW_RECOMMENDATIONS_V2=false
PRODUCT_TREND_AUTO_PUBLISH_ENABLED=false
PRODUCT_TREND_SHADOW_MODE=true
PRODUCT_TREND_AUTO_PUBLISH_POLICY_VERSION=trend-now-autopublish-v1
PRODUCT_TREND_TARGET_ITEMS=18
PRODUCT_TREND_MIN_ITEMS=12
PRODUCT_TREND_PIPELINE_MAX_RUNTIME_SECONDS=900
PRODUCT_TREND_SERVICE_PRINCIPAL_KEY=trend-now-orchestrator
PRODUCT_TREND_TASK_ROLE_ARN=
PRODUCT_TREND_HEALTH_MIN_ELIGIBLE_ITEMS=12
PRODUCT_TREND_HEALTH_MAX_FALLBACK_RATIO=0.10
PRODUCT_TREND_HEALTH_MIN_REQUESTS=20
PRODUCT_TREND_HEALTH_BUCKET_RETENTION_DAYS=8
# Legacy experiment only. The Trend Now production scheduler does not use MCP.
PRODUCT_TREND_MCP_URL=
PRODUCT_TREND_MCP_TOOL=collect_beauty_trends
PRODUCT_TREND_MCP_BEARER_TOKEN=
PRODUCT_TREND_MCP_ALLOWED_HOSTS=
PRODUCT_TREND_MCP_TIMEOUT_SECONDS=8
PRODUCT_CATALOG_ALLOWED_SELLER_DOMAINS=
PRODUCT_CATALOG_ALLOWED_IMAGE_DOMAINS=
PRODUCT_EVENT_SIGNING_SECRET=
PRODUCT_CATALOG_MANIFEST_SIGNING_SECRET=
PRODUCT_SEASONAL_MANIFEST_SIGNING_SECRET=
# Candidates farther than this CIEDE2000 distance are not called a close AR color match.
PRODUCT_AR_MAX_DELTA_E=18.0
PRODUCT_OFFER_MAX_AGE_HOURS=168
# Report completion runs this in the existing background snapshot worker.
# Missing credentials or failed evidence gates remain empty; there is no mock fallback.
MAKEUP_REPORT_PRODUCT_DISCOVERY_ENABLED=true
MAKEUP_REPORT_PRODUCT_DISCOVERY_TIMEOUT_SECONDS=24
MAKEUP_REPORT_PRODUCT_DISCOVERY_CANDIDATES_PER_CATEGORY=12
MAKEUP_REPORT_PRODUCT_DISCOVERY_MAX_IMAGE_BYTES=3145728
PRODUCT_SEASONAL_SOURCE_MAX_AGE_DAYS=30
PRODUCT_PERSONALIZATION_EXPERIMENT_PERCENT=50
PRODUCT_COHORT_EXPERIMENT_PERCENT=50
PRODUCT_PERSONALIZATION_REQUIRE_AGE_14=true
PRODUCT_COHORT_MIN_SIZE=100
PRODUCT_COHORT_MIN_ITEM_SUPPORT=5
PRODUCT_EVENT_RETENTION_DAYS=90
PRODUCT_PROFILE_RETENTION_DAYS=180
PRODUCT_RUN_RETENTION_DAYS=30
PRODUCT_RAW_SEARCH_RETENTION_DAYS=30

# AWS Chime SDK Meetings for consulting video calls.
CHIME_ENABLED=false
CHIME_CONTROL_REGION=ap-northeast-2
CHIME_REGION=ap-northeast-2
CHIME_MEDIA_REGION=ap-northeast-2
CONSULTING_CALL_ENFORCE_EARLY_WINDOW=true
CONSULTING_CALL_JOIN_EARLY_MINUTES=15
CONSULTING_CALL_JOIN_LATE_MINUTES=30
# 로컬 카메라/Chime 테스트에서만 true. 운영 환경에서는 설정해도 시간 제한을 우회하지 않습니다.
CONSULTING_CALL_ALLOW_OUTSIDE_WINDOW=false

# Beard-removal orchestration. SigV4-signed proxy to the AWS Lambda Function URL.
BEARD_LAMBDA_FUNCTION_URL=
BEARD_LAMBDA_REGION=us-west-2
BEARD_S3_BUCKET=

CORS_ENABLED=false
CORS_ALLOW_ORIGINS=
