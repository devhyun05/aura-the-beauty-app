APP_NAME="AI AR Makeup Backend"
ENVIRONMENT=local
DEBUG=false
API_PREFIX=/api

DATABASE_URL=
# Host port used only by docker-compose.yml; override when 5432 is occupied.
AURA_POSTGRES_PORT=5432
# Optional alternative to DATABASE_URL for RDS-managed passwords.
# When set, the backend reads username/password from Secrets Manager.
DATABASE_SECRET_ID=
DB_HOST=
DB_PORT=5432
DB_NAME=
DB_SSLMODE=require

# Keep true whenever multiple people or a shared database use this backend.
# false maps every request to the single DEV_USER_* identity.
AUTH_REQUIRED=true
DEV_USER_SUB=local-dev-user
DEV_USER_EMAIL=dev@example.com
DEV_USER_NAME="Local Dev"

AWS_REGION=ap-northeast-2
AWS_PROFILE_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_USE_IAM_ROLE=false

AI_PROVIDER=bedrock
IMAGE_GENERATION_PROVIDER=openai
# Keep inline for local development. Set sqs after the ECS worker and queue are deployed.
AI_JOB_EXECUTION_MODE=inline
SQS_AI_JOB_QUEUE_URL=
OPENAI_ENABLED=true
BEDROCK_MODEL_ID=anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_ANALYSIS_MODEL_ID=
# ap-northeast-2에서 이 모델은 on-demand invoke 불가 — cross-region inference profile 필수.
BEDROCK_ANALYSIS_INFERENCE_ID=apac.anthropic.claude-3-5-sonnet-20241022-v2:0
BEDROCK_ANALYSIS_REGION=ap-northeast-2
BEDROCK_GUARDRAIL_ID=xxe1xkbvyg34
BEDROCK_GUARDRAIL_VERSION=4
BEDROCK_GUARDRAIL_REGION=ap-northeast-2
BEDROCK_GUARDRAIL_REQUIRED=true
BEDROCK_GUARDRAIL_TRACE=false
BEDROCK_EMBEDDING_MODEL_ID=amazon.titan-embed-text-v2:0
BEDROCK_EMBEDDING_REGION=ap-northeast-2
EMBEDDING_DIMENSION=1024

# Auradin search agent. `auto` uses a persisted embedding vector index when one
# exists and falls back to lexical search. Set `embedding` to require vector
# search. Set `AURADIN_SESSION_STORE=postgres` with DATABASE_URL to persist
# search sessions across backend restarts.
AURADIN_RETRIEVAL_BACKEND=auto
AURADIN_VECTOR_INDEX_PATH=
AURADIN_VECTOR_INDEX_AUTOBUILD=false
AURADIN_SESSION_STORE=postgres
AURADIN_SESSION_TTL_SECONDS=900

COGNITO_USER_POOL_ID=
COGNITO_APP_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_ID=

S3_BUCKET_NAME=
CLOUDFRONT_DOMAIN=
CDN_BASE_URL=
OPENAI_API_KEY=
OPENAI_ANALYSIS_MODEL_ID=gpt-5.5
OPENAI_IMAGE_MODEL_ID=gpt-image-2
OPENAI_IMAGE_QUALITY=low
OPENAI_IMAGE_SIZE=auto
OPENAI_IMAGE_OUTPUT_FORMAT=jpeg
OPENAI_IMAGE_OUTPUT_COMPRESSION=80
OPENAI_IMAGE_INPUT_MAX_EDGE=1024
OPENAI_IMAGE_INPUT_QUALITY=82
OPENAI_IMAGE_OUTPUT_MAX_EDGE=1024
HAIR_JOBS_QUEUE_URL=
HAIR_STYLE_ASSET_BUCKET=
HAIR_STYLE_ASSET_PREFIX=catalog/hair-styles/v1
HAIR_STYLE_ASSETS_REQUIRE_APPROVAL=true
HAIR_SOURCE_RETENTION_HOURS=24
HAIR_SIMULATIONS_PER_ANALYSIS=3
HAIR_SIMULATIONS_PER_DAY=6
HAIR_WORKER_WAIT_TIME_SECONDS=20
HAIR_WORKER_VISIBILITY_TIMEOUT_SECONDS=360
HAIR_WORKER_REQUEST_TIMEOUT_SECONDS=180
HAIR_GENERATION_QUALITY=medium
HAIR_SEGMENTER_MODEL_PATH=/app/models/hair_segmenter.tflite

# Legacy-only credentials. The licensed V2 catalog never ingests Naver Shopping
# Search results. Leave LEGACY_NAVER_PRODUCT_SEARCH=false outside an approved rehearsal.
NAVER_SHOPPING_CLIENT_ID=
NAVER_SHOPPING_CLIENT_SECRET=

# Product recommendation V2. Data-backed sections still stay honestly empty
# until a signed, rights-valid manifest is imported.
PRODUCT_HUB_V2=true
SEASONAL_RECOMMENDATIONS_V1=true
AR_RECIPE_PERSISTENCE_V1=true
AR_PRODUCT_RECOMMENDATIONS_V1=true
ENGAGEMENT_PERSONALIZATION_V1=false
COHORT_RECOMMENDATIONS_V1=false
LEGACY_NAVER_PRODUCT_SEARCH=false
NAVER_SHOPPING_INSIGHT_ENABLED=false
NAVER_SHOPPING_INSIGHT_ENDPOINT=
PRODUCT_CATALOG_ALLOWED_SELLER_DOMAINS=
PRODUCT_CATALOG_ALLOWED_IMAGE_DOMAINS=
PRODUCT_EVENT_SIGNING_SECRET=
PRODUCT_CATALOG_MANIFEST_SIGNING_SECRET=
PRODUCT_SEASONAL_MANIFEST_SIGNING_SECRET=
# Candidates farther than this CIEDE2000 distance are not called a close AR color match.
PRODUCT_AR_MAX_DELTA_E=18.0
PRODUCT_OFFER_MAX_AGE_HOURS=168
PRODUCT_SEASONAL_SOURCE_MAX_AGE_DAYS=30
PRODUCT_PERSONALIZATION_EXPERIMENT_PERCENT=50
PRODUCT_COHORT_EXPERIMENT_PERCENT=50
PRODUCT_PERSONALIZATION_REQUIRE_AGE_14=true
PRODUCT_COHORT_MIN_SIZE=100
PRODUCT_COHORT_MIN_ITEM_SUPPORT=5
PRODUCT_EVENT_RETENTION_DAYS=90
PRODUCT_PROFILE_RETENTION_DAYS=180
PRODUCT_RUN_RETENTION_DAYS=30
PRODUCT_RAW_SEARCH_RETENTION_DAYS=30

# AWS Chime SDK Meetings for consulting video calls.
CHIME_ENABLED=false
CHIME_CONTROL_REGION=ap-northeast-2
CHIME_REGION=ap-northeast-2
CHIME_MEDIA_REGION=ap-northeast-2
CHIME_TRANSCRIPTION_ENABLED=false
CHIME_TRANSLATE_ENABLED=false
CHIME_TRANSCRIBE_SUPPORTED_LANGUAGES=ko-KR,en-US
CHIME_TRANSCRIBE_DEFAULT_LANGUAGE=ko-KR
CHIME_TRANSCRIBE_PREFERRED_LANGUAGE=ko-KR
CONSULTING_CALL_JOIN_EARLY_MINUTES=15
CONSULTING_CALL_JOIN_LATE_MINUTES=30
# 로컬 카메라/Chime 테스트에서만 true. 운영 환경에서는 설정해도 시간 제한을 우회하지 않습니다.
CONSULTING_CALL_ALLOW_OUTSIDE_WINDOW=false
CONSULTING_CALL_TRANSCRIPTION_ENABLED=false
CONSULTING_CALL_TRANSLATION_ENABLED=false
CONSULTING_TRANSCRIPT_RETENTION_DAYS=0

CORS_ENABLED=false
CORS_ALLOW_ORIGINS=
