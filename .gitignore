.DS_Store

# Dependencies and local package-manager caches
node_modules/
.pnpm-store/
.yarn/

# Expo / React Native local state
.expo/
.expo-shared/
apps/mobile/.expo/

# Environment files
.env
.env.*
!*.env.example
!**/.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
*.log

# Local agentctl control plane state and secrets
.agents/approvals/
.agents/hook-runs/
.agents/local.env
.agents/meter/
.agents/queue/
.agents/runs/
.agents/schedule/
.agents/shims/
.agents/tmp/

# Python local state
__pycache__/
*.py[cod]
.venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage

# iOS generated build products
apps/mobile/ios/Pods/
apps/mobile/ios/build/
apps/mobile/ios/DerivedData/
apps/mobile/ios/**/*.xcuserdata/
*.xcuserstate

# Generated screenshots and browser test artifacts
apps/mobile/screenshots/
output/
playwright-report/
test-results/

# Generated build/run artifacts (face3d, unity-ar-engine — large, regenerated)
artifacts/

# Unity generated files and exports
apps/mobile/ios/UnityBuild/
apps/unity-builds/
apps/unity/MakeupAR/Library/
apps/unity/MakeupAR/Temp/
apps/unity/MakeupAR/Obj/
apps/unity/MakeupAR/Build/
apps/unity/MakeupAR/Builds/
apps/unity/MakeupAR/Logs/
apps/unity/MakeupAR/UserSettings/
apps/unity/MakeupAR/MemoryCaptures/
apps/unity/MakeupAR/*.csproj
apps/unity/MakeupAR/*.sln
apps/unity/MakeupAR/*.user
# Local Unity package tarballs (large binaries, e.g. homuler mediapipe .tgz)
apps/unity/MakeupAR/Packages/local/

# Eyeliner mask PNG dumps from the Unity editor exporter (debug only)
tmp-debug/

# Unity XR simulation temp artifacts
apps/unity/MakeupAR/Assets/XR/Temp/
apps/unity/MakeupAR/Assets/XR/Temp.meta

# Beard simulation lab — real face photos and run artifacts must never be committed
tools/beard-simulation-lab/samples/
tools/beard-simulation-lab/outputs/
tools/beard-simulation-lab/.venv/
tools/beard-simulation-lab/external/
tools/beard-simulation-lab/.hf-cache/
tools/beard-simulation-lab/.mplconfig/

# Local tool state (session-generated)
.codegraph/
.playwright-mcp/
.vscode/

# Stray local duplicate (do not track; kept on disk)
AuradinRN 2/

# Lab archive: 기록(json/md)만 커밋, 미디어·개인정보는 로컬 보관
아카이브/**/*.png
아카이브/**/*.PNG
아카이브/**/*.jpg
아카이브/**/*.JPG
아카이브/**/*.jpeg
아카이브/**/*.webp
아카이브/aihub_faces/
newbeards/
