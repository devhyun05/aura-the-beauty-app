Project ai_ar_makeup_guide {
  database_type: 'PostgreSQL'
  Note: 'Backend integration v1 schema based on latest dev screens. Flexible AI/AR sections are stored as jsonb payloads.'
}

Enum auth_provider {
  google
  kakao
  naver
  apple
}

Enum gender_type {
  female
  male
  other
  unknown
}

Enum media_source_type {
  camera
  gallery
  seed
  generated
}

Enum capture_type {
  face_analysis
  makeup_feedback
  filter_extraction
  ar_try_on
  hair_analysis
}

Enum job_status {
  pending
  processing
  completed
  failed
  cancelled
}

Enum makeup_style_type {
  look
  filter
  recipe
}

Enum product_category {
  lip
  cheek
  shadow
  liner
  base
  brow // R1 (schema.sql:product-category-brow-v1) — Auradin 브로우 찜 카테고리 손실 방지
}

Enum filter_category {
  recommended
  trend
  personal_color
  popular
}

Enum face_part {
  all
  base
  eye
  lip
  contour
}

Enum consent_type {
  privacy_policy
  camera_analysis
  ai_processing
  third_party_ai
  marketing
  engagement_personalization
  color_cohort
}

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  auth_provider auth_provider
  oauth_sub text
  email citext
  name text
  nickname text [not null]
  phone text
  birth_date date
  gender gender_type [not null, default: 'unknown']
  interest text
  personal_color text
  skin_type text
  skin_tone text
  tags text[]
  avatar_media_id uuid
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (auth_provider, oauth_sub) [unique]
    (email)
  }

  Note: 'Login, MyPage, ProfileEdit. Beauty profile fields are kept here for v1 API simplicity.'
}

Table media_assets {
  id uuid [pk, default: `gen_random_uuid()`]
  owner_user_id uuid
  media_kind text [not null]
  source media_source_type [not null]
  bucket text
  object_key text
  cdn_url text
  content_type text
  byte_size bigint
  width integer
  height integer
  checksum_sha256 text
  original_filename text
  is_original boolean [not null, default: true]
  status text [not null, default: 'active']
  created_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (bucket, object_key) [unique]
    (owner_user_id, created_at)
  }

  Note: 'S3/CDN metadata for app media. golden-mask rows are private-only `.auragm` objects with application/vnd.aura.golden-mask and no CDN URL.'
}

Table media_upload_sessions {
  id uuid [pk]
  owner_user_id uuid
  partner_account_id uuid
  media_kind text [not null]
  source media_source_type [not null]
  bucket text [not null]
  object_key text [not null]
  cdn_url text
  content_type text [not null]
  expected_byte_size bigint
  width integer
  height integer
  original_filename text
  thumbnail_bucket text
  thumbnail_object_key text
  thumbnail_cdn_url text
  thumbnail_content_type text
  thumbnail_expected_byte_size bigint
  thumbnail_width integer
  thumbnail_height integer
  status text [not null, default: 'pending', note: 'pending | completed | expired']
  media_asset_id uuid
  expires_at timestamptz [not null]
  completed_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (bucket, object_key) [unique]
    (thumbnail_bucket, thumbnail_object_key) [unique]
    (owner_user_id, status, expires_at)
    (partner_account_id, status, expires_at)
    (expires_at)
  }

  Note: 'Server-issued, principal-bound S3 upload locations consumed exactly once.'
}

Table photo_captures {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  media_id uuid [not null]
  capture_type capture_type [not null]
  source media_source_type [not null]
  status job_status [not null, default: 'pending']
  captured_at timestamptz [not null, default: `now()`]
  device_payload jsonb [not null, default: '{}']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, capture_type, created_at)
  }

  Note: 'A single uploaded/captured image can feed analysis, feedback, filter extraction, or AR try-on.'
}

Table analysis_reports {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  photo_capture_id uuid
  source_media_id uuid
  preview_media_id uuid
  golden_mask_media_id uuid
  golden_mask_metadata jsonb [not null, default: '{}', note: 'aura.golden-mask.v1 attachment metadata']
  status job_status [not null, default: 'completed']
  ai_provider text
  ai_model text
  request_id text
  error_message text
  analyzed_at timestamptz
  title text [not null]
  report_title text [not null]
  environment_label text
  personal_color text
  face_shape text
  skin_type text
  tone_summary text
  recommended_mood text
  summary text
  short_summary text
  skin_analysis_summary text
  base_makeup_guide text
  tags text[]
  detail_payload jsonb [not null, default: '{}']
  embedding vector(1024)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (user_id, analyzed_at)
    (user_id, analyzed_at) [note: 'Partial index where deleted_at is null']
    (golden_mask_media_id) [note: 'Partial index where golden_mask_media_id is not null']
  }

  Note: 'ImageAnalysisReportsList and ImageAnalysisReportDetail. facePointGuide, recommendedMakeups, avoidedMakeups live in detail_payload.'
}

Table face_measurement_preferences {
  user_id uuid [pk]
  self_selected_locale text
  locale_selection_source text [not null, default: 'unset', note: 'unset | self_selected; server-owned provenance']
  locale_selected_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  Note: 'Explicit user selection only. Device locale, network, profile, and face inference must never populate this row.'
}

Table face_length_measurement_snapshots {
  report_id uuid [pk]
  measurement_capture_id text [not null, note: 'Distinct capture identity; repeated reports from one capture do not advance history count']
  measurement_contract_id text [not null, note: 'Measurement algorithm contract, never the population judgment version']
  face_length_ratio double [not null]
  estimate_low double [not null]
  estimate_high double [not null]
  captured_at timestamptz [not null]
  evidence_provenance text [not null, default: 'client_observed_unverified', note: 'Unverified client-observed product history only']
  norm_training_eligible boolean [not null, default: false, note: 'Always false for product history']
  norm_attestation_id text [note: 'Always null for product history; approved norm evidence uses an offline attested manifest instead']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (measurement_contract_id, captured_at, report_id)
  }

  Note: 'Unverified client-observed same-user history only. Values must be finite and positive with estimate_low <= ratio <= estimate_high. Norm training and activation are prohibited; raw images and landmarks are prohibited.'
}

Table face3d_calibration_receipt_consumptions {
  receipt_id text [pk]
  capture_nonce text [not null, unique]
  profile_binding_sha256 text [not null]
  collection_policy_id text [not null]
  gate_version text [not null]
  signing_key_id text [not null]
  approval_artifact_sha256 text [not null]
  subject_context_id text [not null]
  report_context_id text [not null]
  issued_at timestamptz [not null]
  expires_at timestamptz [not null]
  consumed_at timestamptz [not null, default: `now()`]

  indexes {
    (subject_context_id, report_context_id)
  }

  Note: 'One-time replay ledger for server-verified Face3D calibration receipts. Empty while Phase 2 promotion is OFF.'
}

Table analysis_stage_runs {
  id uuid [pk, default: `gen_random_uuid()`]
  report_id uuid [not null]
  stage text [not null, note: 'ai_measurement | ai_perception | ai_consulting']
  status text [not null, note: 'pending | processing | completed | partial | failed']
  schema_version text [not null]
  prompt_version text [not null]
  model text [not null]
  input_hash text [not null]
  normalized_output jsonb [not null, default: '{}']
  raw_response jsonb [not null, default: '{}']
  error_payload jsonb [not null, default: '{}']
  attempt_count integer [not null, default: 1]
  started_at timestamptz
  completed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (report_id, stage, created_at)
    (stage, input_hash, schema_version, prompt_version, model)
    (report_id, stage) [unique, note: 'Partial unique index where status = processing']
  }
}

Table makeup_situations {
  id uuid [pk, default: `gen_random_uuid()`]
  key text [not null, unique]
  label text [not null]
  description text [not null]
  image_asset_key text [note: 'Mobile bundled static asset registry key; null for custom']
  icon_key text
  sort_order integer [not null, default: 0]
  status text [not null, default: 'active', note: 'active | disabled']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (status, sort_order, key)
  }

  Note: 'Stable parent situations. The custom row has no required parent image.'
}

Table makeup_scenario_library {
  id uuid [pk, default: `gen_random_uuid()`]
  text text [not null]
  normalized_text text [not null]
  seed_prompt text [not null]
  tags jsonb [not null, default: `'[]'::jsonb`]
  source text [not null, default: 'ai', note: 'ai | curated']
  model_id text
  prompt_version text [not null, default: 'makeup-scenario-v2']
  status text [not null, default: 'active', note: 'active | disabled']
  usage_count integer [not null, default: 0]
  last_served_at timestamptz
  created_by_user_id uuid
  keyword_kind text [not null, default: 'legacy_scenario', note: 'curated | steady | trend | legacy_scenario']
  source_name text
  source_url text
  source_published_at timestamptz
  evidence_summary text
  market_scope text
  trend_score numeric(5,4)
  confidence text [note: 'A | B']
  review_status text [not null, default: 'draft', note: 'draft | approved | rejected; evidence-complete imports remain draft until explicit approval']
  locale text [not null, default: 'ko-KR']
  as_of timestamptz
  valid_from timestamptz
  expires_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (status, usage_count, created_at)
    (source, status, usage_count, last_served_at, created_at)
    (locale, keyword_kind, review_status, status, expires_at)
    (normalized_text, locale, `coalesce(market_scope, '')`) [unique, name: 'uq_makeup_scenario_library_locale_scope']
  }

  Note: 'Backward-compatible V1 scenario library extended as the V2 keyword registry. Trend rows require source and freshness evidence even while draft. Keyword uniqueness is scoped to normalized_text + locale + coalesced market_scope; only approved, active-mapped, non-expired rows are exposed with trend badges.'
}

Table makeup_situation_keywords {
  situation_id uuid [not null]
  keyword_id uuid [not null]
  relevance_score numeric(5,4) [not null, default: 1]
  sort_order integer [not null, default: 0]
  status text [not null, default: 'active', note: 'active | disabled']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (situation_id, keyword_id) [pk]
    (situation_id, status, sort_order, relevance_score)
  }

  Note: 'Many-to-many mapping so the same makeup keyword can appear under several parent situations.'
}

Table makeup_keyword_question_templates {
  id uuid [pk, default: `gen_random_uuid()`]
  keyword_id uuid [not null]
  template_version integer [not null, note: 'Positive reviewed-copy version']
  locale text [not null, default: 'ko-KR']
  questions jsonb [not null, note: 'Validated GeneratedQuestions array with 1..3 questions']
  source text [not null, default: 'curated', note: 'curated | ai_generated']
  model_id text
  prompt_version text [not null]
  review_status text [not null, default: 'draft', note: 'draft | approved | rejected']
  status text [not null, default: 'active', note: 'active | retired']
  reviewed_at timestamptz [note: 'Required when review_status is approved']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (keyword_id, template_version) [unique]
    keyword_id [unique, name: 'uq_makeup_keyword_question_templates_active_reviewed', note: 'Partial unique index where status = active and review_status = approved']
    (keyword_id, locale, status, review_status, template_version) [name: 'idx_makeup_keyword_question_templates_lookup']
  }

  Note: 'Versioned, human-reviewed reverse-question copy for predefined situation keywords. Runtime AI is reserved for custom input or an explicitly unreviewed keyword.'
}

Table makeup_scenario_generation_limits {
  user_id uuid [pk]
  window_started_at timestamptz [not null, default: `now()`]
  request_count integer [not null, default: 0, note: '0..4; retained for V1 compatibility']
}

Table makeup_recommendation_sessions {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  analysis_report_id uuid [not null]
  situation_id uuid [note: 'Nullable for the custom prompt path']
  keyword_id uuid
  custom_situation_text text
  context_snapshot jsonb [not null, default: `'{}'::jsonb`]
  questions jsonb [not null, default: `'[]'::jsonb`]
  answers jsonb [not null, default: `'[]'::jsonb`]
  current_question_index integer [not null, default: 0]
  status text [not null, default: 'questioning', note: 'questioning | ready | generating | completed | failed | expired']
  report_id uuid
  idempotency_key text [not null]
  image_mode text [not null, default: 'generic', note: 'generic | personalized']
  expires_at timestamptz [not null, default: `now() + interval '24 hours'`]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, idempotency_key) [unique]
    (report_id) [unique]
    (user_id, created_at)
    (user_id, status, expires_at)
  }

  Note: 'Server-authoritative V2 question flow, report selection, context snapshot and idempotency state.'
}

Table makeup_recommendation_reports {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  parent_report_id uuid
  refinement_type text [note: 'natural | hip | differentColor | replaceProducts']
  scenario_text text [not null]
  scenario_tags jsonb [not null, default: `'[]'::jsonb`]
  questions jsonb [not null, default: `'[]'::jsonb`]
  answers jsonb [not null, default: `'[]'::jsonb`]
  recommendation jsonb [not null]
  image_status text [not null, default: 'pending', note: 'pending | processing | partial | completed | failed']
  image_url text [note: 'Generic public compatibility URL only; never persisted for a private personalized asset']
  image_error text
  scenario_model_id text
  question_model_id text
  recommendation_model_id text
  image_model_id text
  prompt_version text [not null]
  source_analysis_report_id uuid
  session_id uuid
  situation_id uuid [note: 'Nullable for the custom prompt path']
  keyword_id uuid
  context_snapshot jsonb [not null, default: `'{}'::jsonb`]
  schema_version text [not null, default: 'makeup-recommendation-v2']
  image_mode text [not null, default: 'generic', note: 'generic | personalized']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, created_at)
    (parent_report_id)
    (session_id) [unique]
  }

  Note: 'Stores V1-compatible recommendation data plus the selected owned analysis report, immutable allowlisted context snapshot, V2 session, taxonomy and image mode.'
}

Table makeup_recommendation_assets {
  id uuid [pk, default: `gen_random_uuid()`]
  report_id uuid [not null]
  look_id text [not null]
  role text [not null, note: 'anchor | bold | discovery']
  status text [not null, default: 'pending', note: 'pending | processing | completed | failed']
  image_url text [note: 'Only generic delivery URL; private personalized rows keep this null']
  image_error text
  storage_bucket text
  object_key text
  content_type text
  is_private boolean [not null, default: false]
  input_media_id uuid
  model_id text [not null]
  prompt_version text [not null]
  provenance jsonb [not null, default: `'{}'::jsonb`, note: 'Exact sent prompt, model/prompt version, consent and rights status, and validated output format/dimensions']
  attempt_count integer [not null, default: 0]
  last_attempt_at timestamptz
  completed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (report_id, look_id) [unique]
    (report_id, status, role)
  }

  Note: 'Per-look image lifecycle. Personalized objects are private and delivered through a fresh authenticated signed URL, never a persisted public URL.'
}

Table hair_analyses {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  client_request_id uuid [not null]
  photo_capture_id uuid
  source_media_id uuid [not null]
  mask_media_id uuid
  status text [not null, default: 'queued', note: 'queued | processing | completed | failed | expired']
  analysis_payload jsonb [not null, default: '{}']
  recommended_style_ids text[] [not null, default: '{}']
  error_code text
  error_message text
  attempt_count integer [not null, default: 0]
  expires_at timestamptz [not null]
  completed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, client_request_id) [unique]
    (user_id, created_at)
    (status, created_at)
    (expires_at)
  }
}

Table hair_simulations {
  id uuid [pk, default: `gen_random_uuid()`]
  analysis_id uuid [not null]
  user_id uuid [not null]
  client_request_id uuid [not null]
  style_id text [not null]
  status text [not null, default: 'queued', note: 'queued | processing | completed | failed | expired']
  result_media_id uuid
  provider text
  model text
  attempt_count integer [not null, default: 0]
  quality_attempt_count integer [not null, default: 0]
  quality_payload jsonb [not null, default: '{}']
  error_code text
  error_message text
  saved_at timestamptz
  expires_at timestamptz
  completed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, client_request_id) [unique]
    (analysis_id, style_id) [unique]
    (analysis_id, created_at)
    (user_id, created_at)
    (expires_at)
  }
}

Table saved_makeup_styles {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  client_request_id uuid [not null, default: `gen_random_uuid()`]
  style_type makeup_style_type [not null, default: 'look']
  source_analysis_report_id uuid
  source_filter_extraction_id uuid
  source_media_id uuid
  thumbnail_media_id uuid
  title text [not null]
  mood_label text
  short_description text
  tags text[]
  visibility text [not null, default: 'private']
  style_payload jsonb [not null, default: '{}']
  saved_at timestamptz [not null, default: `now()`]
  archived_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, client_request_id) [unique]
    (user_id, saved_at)
    (source_analysis_report_id)
    (source_filter_extraction_id)
  }

  Note: 'MakeupStyleList plus saved filters and saved recipes from the filter extraction flow.'
}

Table product_recommendation_operators {
  user_id uuid [pk]
  roles text[] [not null, note: 'catalog_admin | seasonal_editor | seasonal_reviewer | seasonal_publisher | seasonal_operator']
  is_active boolean [not null, default: true]
  granted_by uuid
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    roles [type: gin, note: 'Partial in SQL where is_active=true']
  }

  Note: 'Explicit internal RBAC grants for signed catalog and seasonal operations.'
}

Table product_recommendation_service_principals {
  id uuid [pk, default: `gen_random_uuid()`]
  principal_key text [not null, unique]
  display_name text [not null]
  external_subject text [unique, note: 'Optional IAM workload identity; no credential material is stored.']
  roles text[] [not null, default: '{seasonal_auto_publisher}']
  status text [not null, default: 'active', note: 'active | disabled | revoked']
  created_by uuid
  last_used_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    roles [type: gin, note: 'Partial in SQL where status=active']
  }

  Note: 'Credential-free identity for scheduled seasonal auto-publication; human seasonal RBAC remains separate.'
}

Table products {
  id uuid [pk, default: `gen_random_uuid()`]
  external_key text [unique]
  brand_name text [not null]
  product_name text [not null]
  shade_name text
  category product_category [not null]
  price_krw integer [not null, default: 0]
  image_media_id uuid
  tags text[]
  palette text[]
  product_payload jsonb [not null, default: '{}']
  source_provider text
  source_license_type text
  source_reference text
  license_status text [not null, default: 'unverified', note: 'unverified | valid | expired | blocked']
  license_valid_from timestamptz
  license_valid_until timestamptz
  allowed_uses text[] [not null, default: '{}']
  catalog_status text [not null, default: 'draft', note: 'draft | reviewed | published | blocked']
  catalog_version text [not null, default: 'catalog_v2']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (category, is_active)
  }

  Note: 'ProductRecommendation and LikedProductList product catalog.'
}

Table user_product_likes {
  user_id uuid [not null]
  product_id uuid [not null]
  source_shade_id uuid [note: 'Optional recommendation context; the heart remains product-family scoped.']
  liked_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, product_id) [pk]
    (user_id, liked_at)
  }

  Note: 'LikedProductList and product heart state.'
}

Table external_product_likes {
  user_id uuid [not null]
  external_source text [not null, note: 'Allowlisted server-resolved provider identifier: naver_shopping_search | auradin_search | auradin_catalog.']
  external_product_id text [not null]
  brand_name text [not null]
  product_name text [not null]
  category text [not null]
  image_url text [not null]
  purchase_url text [not null]
  price_amount numeric(12,2)
  price_currency char(3) [not null, default: 'KRW']
  source_updated_at timestamptz
  liked_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, external_source, external_product_id) [pk]
    (user_id, liked_at)
    (external_source, external_product_id, liked_at)
  }

  Note: 'User bookmarks for server-verified external shopping results or owner-bound Auradin results; legacy auradin_search rows with auradin-seed-* IDs are normalized to auradin_catalog; never part of the trusted catalog.'
}

Table auradin_search_sessions {
  session_id text [pk]
  state jsonb [not null]
  expires_at timestamptz [not null]
  updated_at timestamptz [not null]
  owner_subject text [not null]
  version integer [not null, default: 0]
  client_request_id text
  request_fingerprint text
  idempotency_expires_at timestamptz

  indexes {
    expires_at
    (owner_subject, client_request_id) [unique, note: 'partial: client_request_id is not null']
    idempotency_expires_at [note: 'partial: idempotency_expires_at is not null']
  }

  Note: 'Temporary Auradin conversation state. Product likes remain in user_product_likes. A9 v2: create 멱등성(client_request_id+fingerprint+retention)과 mutator version CAS.'
}

Table auradin_events {
  id bigserial [pk]
  client_event_id text [not null]
  schema_version smallint [not null, default: 1]
  owner_subject text [not null, note: 'anon:v1:<HMAC-digest> | user:v1:<issuer-scope>:<sub> — dev fallback 공용 subject 금지']
  session_id text
  turn_id text
  result_set_id text
  event_type text [not null, note: '11종 enum: session_start | question_answered | impression | product_open | save | unsave | purchase_click | refine_dial | refine_prompt | hide | unhide']
  product_id text
  category text
  rank int
  role text
  match_rate int
  data_manifest_id text [not null, note: '귀속 정본 (Data Manifest)']
  release_manifest_id text [not null, note: '귀속 정본 (Release Manifest)']
  catalog_run_date text
  ranker_version text
  payload jsonb [note: 'scoreSnapshot/filterDelta/dial 등 구조화 값만 — raw query 원문 저장 금지']
  occurred_at timestamptz [not null, note: '클라이언트 발생 시각']
  received_at timestamptz [not null, default: `now()`, note: '서버 수신 시각']
  experiment_id text
  variant text

  indexes {
    (owner_subject, client_event_id) [unique]
    (owner_subject, occurred_at) [note: 'occurred_at desc']
    session_id
    data_manifest_id
    received_at
  }

  Note: 'A5 §7.2 Auradin behavioral events. 보존: received_at 기반 주기 배치 DELETE. 사용자 삭제는 파생 user_taste_profile과 한 트랜잭션.'
}

Table auradin_catalog_snapshots {
  snapshot_id text [pk, note: "e.g. 'snapshot_20260719'"]
  manifest_sha256 text [not null, note: 'manifest file sha256 — idempotency key']
  catalog_sha256 text [not null, note: 'catalog JSONL sha256 recorded in manifest']
  manifest_path text [not null]
  item_count integer [not null]
  color_family_count integer [not null, default: 0, note: 'rows with attributes.colorFamily set']
  quality_summary jsonb [not null, default: `'{}'`, note: 'a8_quality_summary output']
  status text [not null, default: 'imported', note: 'importing | imported | active | superseded | failed']
  imported_at timestamptz [not null, default: `now()`]
  activated_at timestamptz

  Note: 'Auradin catalog import ledger (schema.sql:auradin-catalog-mirror-v1). status=active marks the served snapshot.'
}

Table auradin_catalog_items {
  snapshot_id text [not null, ref: > auradin_catalog_snapshots.snapshot_id]
  item_id text [not null, note: 'JSONL row id (auradin-seed-*/auradin-mvp-*)']
  category text [note: 'lip/cheek/shadow/liner/brow/base']
  brand_name text
  product_name text
  color_family text [note: 'attributes.colorFamily (nullable)']
  color_family_confidence real [note: 'attributeConfidence.colorFamily (optional -> null)']
  finish text
  texture text
  undertone text [note: 'reference only; undertone hard-filter forbidden']
  price_krw integer [note: 'liveOffer.priceKrw']
  is_purchasable boolean [not null, default: false]
  hard_filter_eligible jsonb [not null, default: `'{}'`]
  payload jsonb [not null, note: 'full original JSONL row']

  indexes {
    (snapshot_id, item_id) [pk]
    (snapshot_id, category)
    (snapshot_id, color_family)
    (snapshot_id, brand_name)
    payload [type: gin]
  }

  Note: 'Auradin catalog rows mirrored per snapshot. Query auradin_active_catalog view for the active snapshot. Serving unaffected (JSONL-backed).'
}

Table product_recommendation_runs {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  source_analysis_report_id uuid
  source_makeup_report_id uuid [note: 'Owned situation makeup report; cascade-deletes all derived snapshot revisions']
  source_look_id text [note: 'Stable nested report look id; required for makeup_report_v1']
  user_nickname text
  look_title text
  look_description text
  look_media_id uuid
  source_style_id uuid
  strategy text [not null, default: 'legacy_v1', note: 'legacy_v1 | ar_v1 | seasonal_v1 | personalized_v1 | cohort_v1 | makeup_report_v1']
  algorithm_version text
  recipe_hash text [note: 'Lowercase SHA-256 of the normalized report/look targets']
  catalog_version text [note: 'Deterministic catalog input version used for this immutable revision']
  status text [not null, default: 'ready', note: 'pending | processing | ready | partial | failed']
  revision integer [not null, default: 1, note: 'Monotonic refresh revision, >= 1']
  consent_snapshot jsonb [not null, default: '{}']
  product_ids uuid[]
  recommendation_payload jsonb [not null, default: '{}', note: 'Stable ranked product/shade identity snapshot; price, stock and outbound URL are revalidated on read']
  created_at timestamptz [not null, default: `now()`]
  started_at timestamptz [note: 'Worker claim time; processing rows older than the lease can be reclaimed']
  completed_at timestamptz
  error_code text [note: 'Bounded machine-readable code, required only for failed makeup_report_v1 runs']
  expires_at timestamptz [not null, default: `now() + interval '30 days'`]

  indexes {
    (user_id, created_at)
    (source_analysis_report_id)
    (source_makeup_report_id) [name: 'idx_product_recommendation_runs_source_makeup_report', note: 'Partial where source_makeup_report_id is not null; supports report cascade/delete lookup']
    (source_makeup_report_id, source_look_id, recipe_hash, algorithm_version, catalog_version, revision) [unique, name: 'uq_product_recommendation_runs_makeup_snapshot_revision', note: 'Partial unique index where strategy = makeup_report_v1']
    (source_makeup_report_id, source_look_id, revision) [unique, name: 'uq_product_recommendation_runs_makeup_look_revision', note: 'Partial unique index where strategy = makeup_report_v1; serializes refresh revisions across rolling algorithm/catalog releases']
    (user_id, source_makeup_report_id, source_look_id, revision) [name: 'idx_product_recommendation_runs_makeup_ready_revision', note: 'revision DESC; partial where strategy = makeup_report_v1 and status in (ready, partial)']
    (status, started_at, created_at) [name: 'idx_product_recommendation_runs_makeup_work_queue', note: 'Partial worker/reclaim queue where strategy = makeup_report_v1 and status in (pending, processing)']
  }

  Note: 'makeup_report_v1 snapshots are append-only by revision. A refresh creates revision+1, so the latest ready/partial revision remains available while a new revision is processing.'
}

Table product_shades {
  id uuid [pk, default: `gen_random_uuid()`]
  product_id uuid [not null]
  external_shade_key text [not null]
  shade_name text [not null]
  product_region text [not null, note: 'lip | cheek | shadow | liner | base | brow']
  srgb_hex text
  lab_l double
  lab_a double
  lab_b double
  color_family text
  finish text
  coverage text
  opacity double
  evidence_type text [not null]
  evidence_reference text
  evidence_confidence double [not null, default: 0]
  license_status text [not null, default: 'unverified']
  license_valid_from timestamptz
  license_valid_until timestamptz
  allowed_uses text[] [not null, default: '{}']
  measured_at timestamptz
  reviewed_at timestamptz
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (product_id, external_shade_key) [unique]
    (id, product_id) [unique]
    (product_region, finish, lab_l)
    (product_id, is_active)
  }
}

Table product_assets {
  id uuid [pk, default: `gen_random_uuid()`]
  product_id uuid [not null]
  shade_id uuid
  asset_type text [not null, note: 'packshot | swatch | thumbnail']
  media_id uuid
  asset_url text
  checksum_sha256 text
  source_provider text [not null]
  source_reference text
  license_type text
  license_status text [not null, default: 'unverified']
  allowed_uses text[] [not null, default: '{}']
  valid_from timestamptz
  valid_until timestamptz
  reviewed_at timestamptz
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (source_provider, source_reference, asset_type) [unique]
    (product_id, asset_type, is_active)
    valid_until
  }
}

Table product_offers {
  id uuid [pk, default: `gen_random_uuid()`]
  product_id uuid [not null]
  shade_id uuid
  seller_name text [not null]
  seller_domain text [not null]
  purchase_url text [not null]
  currency text [not null, default: 'KRW']
  price_amount integer
  availability_status text [not null, default: 'unknown']
  availability_checked_at timestamptz
  price_updated_at timestamptz
  affiliate_type text [not null, default: 'none']
  disclosure_label text
  source_provider text [not null]
  source_reference text
  license_status text [not null, default: 'unverified']
  allowed_uses text[] [not null, default: '{}']
  valid_until timestamptz
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (source_provider, source_reference) [unique]
    (product_id, availability_status, is_active)
    valid_until
  }
}

Table product_seasonal_collections {
  id uuid [pk, default: `gen_random_uuid()`]
  slug text [not null]
  title text [not null]
  summary text [not null]
  locale text [not null, default: 'ko-KR']
  region_code text [not null, default: 'KR-00', note: 'Coarse region only; KR-00 is nationwide fallback.']
  region_label text [not null, default: '전국']
  trend_window text [not null]
  source_name text [not null, default: 'editorial']
  source_updated_at timestamptz
  source_labels text[] [not null, default: '{}']
  source_payload jsonb [not null, default: '{}']
  trend_keywords text[] [not null, default: '{}']
  reason_codes text[] [not null, default: '{}']
  confidence_score double [not null, default: 0.5]
  valid_from timestamptz [not null]
  valid_until timestamptz [not null]
  reviewed_at timestamptz
  published_at timestamptz
  status text [not null, default: 'draft']
  revision integer [not null, default: 1]
  algorithm_version text [not null, default: 'seasonal_v1']
  input_fingerprint text [note: 'Lowercase SHA-256 of normalized ranking inputs.']
  freshness_status text [not null, default: 'fresh', note: 'fresh | stale | fallback']
  auto_publish_policy_version text
  pipeline_run_id uuid
  published_by_service_principal_id uuid
  next_evaluation_at timestamptz
  created_by uuid
  reviewed_by uuid
  published_by uuid
  previous_revision_id uuid
  suspension_reason text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (slug, revision) [unique]
    (locale, status, valid_from, valid_until)
    (locale, region_code, status, valid_from, valid_until)
    (locale, region_code, input_fingerprint)
    source_updated_at
  }

  Note: 'Published rows use either the separated human path or service-principal pipeline path, never both. Before PostgreSQL partial unique index uq_product_seasonal_single_published is installed, schema.sql deterministically suspends older duplicate published revisions; the index then enforces one status=published row per slug.'
}

Table product_seasonal_collection_items {
  collection_id uuid [not null]
  product_id uuid [not null]
  shade_id uuid
  position integer [not null]
  reason_code text [not null]
  reason_codes text[] [not null, default: '{}']
  match_score double [not null, default: 0]
  score_components jsonb [not null, default: '{}', note: 'RRF/model component scores and eligibility evidence.']
  ranking_model_version text
  sponsorship_type text [not null, default: 'organic']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (collection_id, product_id) [pk]
    (collection_id, position) [unique]
  }
}

Table product_catalog_imports {
  id uuid [pk, default: `gen_random_uuid()`]
  manifest_id uuid [not null, unique]
  manifest_sha256 text [not null]
  source_provider text [not null]
  catalog_version text [not null]
  actor_user_id uuid
  status text [not null, default: 'validated']
  summary jsonb [not null, default: '{}']
  imported_at timestamptz [not null, default: `now()`]
}

Table product_engagement_events {
  id uuid [pk, default: `gen_random_uuid()`]
  event_id uuid [not null]
  user_id uuid [not null]
  run_id uuid
  collection_id uuid
  search_request_id uuid
  product_id uuid
  external_source text [note: 'Allowlisted server-resolved provider identifier; paired with external_product_id and mutually exclusive with product_id.']
  external_product_id text [note: '1..160 characters when external_source is present.']
  shade_id uuid
  event_type text [not null]
  section text [not null]
  position integer
  occurred_at timestamptz [not null]
  received_at timestamptz [not null, default: `now()`]
  context jsonb [not null, default: '{}']

  indexes {
    (user_id, event_id) [unique]
    (user_id, occurred_at)
    occurred_at
    (product_id, event_type, occurred_at)
    (external_source, external_product_id, event_type, occurred_at)
  }

  Note: 'Non-search-submit events contain exactly one trusted catalog product_id or one complete server-verified external product identity.'
}

Table trend_keyword_candidates {
  id uuid [pk, default: `gen_random_uuid()`]
  normalized_keyword text [not null]
  locale text [not null, default: 'ko-KR']
  status text [not null, default: 'observed', note: 'observed | qualified | rejected | suspended | expired']
  category_codes text[] [not null, default: '{}']
  benefit_tags text[] [not null, default: '{}']
  finish_tags text[] [not null, default: '{}']
  confidence_score double [not null, default: 0]
  first_observed_at timestamptz [not null]
  last_observed_at timestamptz [not null]
  qualified_at timestamptz
  expires_at timestamptz
  normalization_metadata jsonb [not null, default: '{}']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (locale, normalized_keyword) [unique]
    (locale, status, last_observed_at)
    category_codes [type: gin]
  }
}

Table trend_source_observations {
  id uuid [pk, default: `gen_random_uuid()`]
  candidate_id uuid [not null]
  source_name text [not null]
  source_kind text [not null, note: 'content | search_trend | shopping_insight | internal_engagement | operator']
  observed_at timestamptz [not null]
  window_started_at timestamptz [not null]
  window_ended_at timestamptz [not null]
  document_count integer [not null, default: 0]
  distinct_content_type_count integer [not null, default: 0]
  distinct_user_count integer
  baseline_7d double
  baseline_28d double
  current_value double
  change_ratio double
  z_score double
  evidence_hash text [not null, note: 'Lowercase SHA-256; raw content is not retained.']
  source_metadata jsonb [not null, default: '{}']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (candidate_id, source_name, evidence_hash) [unique]
    (candidate_id, observed_at)
    (source_kind, source_name, observed_at)
  }

  Note: 'Aggregate trend evidence only. Article bodies and raw user search text are prohibited.'
}

Table weather_region_snapshots {
  id uuid [pk, default: `gen_random_uuid()`]
  region_code text [not null, note: 'KR-00 or one of the coarse Korean region codes.']
  region_label text [not null]
  source_name text [not null, default: 'kma_short_term_forecast']
  source_updated_at timestamptz [not null]
  forecast_at timestamptz [not null]
  expires_at timestamptz [not null]
  temperature_c double
  humidity_percent smallint
  precipitation_probability_percent smallint
  precipitation_mm double
  wind_speed_mps double
  weather_code text
  weather_summary text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (region_code, source_name, forecast_at) [unique]
    (region_code, forecast_at, expires_at)
  }

  Note: 'Coarse regional forecasts only; exact device latitude and longitude are never stored.'
}

Table product_attribute_evidence {
  id uuid [pk, default: `gen_random_uuid()`]
  product_id uuid [not null]
  attribute_key text [not null, note: 'finish, texture, coverage, climate/lasting benefit or skin_type_tags']
  attribute_value jsonb [not null]
  source_type text [not null, note: 'licensed_catalog | brand_official | manual_review | validated_inference']
  source_reference text
  evidence_fingerprint text [not null]
  confidence_score double [not null, default: 0]
  status text [not null, default: 'unverified', note: 'unverified | verified | rejected | expired']
  observed_at timestamptz
  reviewed_at timestamptz
  expires_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (product_id, attribute_key, evidence_fingerprint) [unique]
    (product_id, attribute_key, confidence_score) [note: 'Partial in SQL where status=verified']
    expires_at
  }
}

Table product_signal_hourly {
  bucket_started_at timestamptz [not null]
  region_code text [not null, default: 'KR-00']
  product_id uuid [not null]
  impression_count integer [not null, default: 0]
  product_open_count integer [not null, default: 0]
  like_count integer [not null, default: 0]
  unlike_count integer [not null, default: 0]
  seller_outbound_count integer [not null, default: 0]
  hide_count integer [not null, default: 0]
  distinct_user_count integer [not null, default: 0]
  position_adjusted_score double [not null, default: 0]
  is_privacy_eligible boolean [not null, default: false, note: 'May be true only when distinct_user_count >= 20 (SQL CHECK).']
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (bucket_started_at, region_code, product_id) [pk]
    (product_id, bucket_started_at)
    (region_code, bucket_started_at) [note: 'Partial in SQL where is_privacy_eligible=true']
  }
}

Table search_intent_hourly {
  bucket_started_at timestamptz [not null]
  locale text [not null, default: 'ko-KR']
  region_code text [not null, default: 'KR-00']
  intent_hash text [not null, note: 'Opaque HMAC-SHA-256 intent identifier; never the raw query.']
  candidate_id uuid
  search_count integer [not null, default: 0]
  result_open_count integer [not null, default: 0]
  distinct_user_count integer [not null, default: 0]
  is_privacy_eligible boolean [not null, default: false, note: 'May be true only when distinct_user_count >= 20 (SQL CHECK).']
  datalab_confirmed boolean [not null, default: false]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (bucket_started_at, locale, region_code, intent_hash) [pk]
    (locale, region_code, bucket_started_at) [note: 'Partial in SQL where is_privacy_eligible=true']
    (candidate_id, bucket_started_at)
  }

  Note: 'Privacy-thresholded intent aggregates only; raw search queries are prohibited.'
}

Table seasonal_serving_health_buckets {
  bucket_started_at timestamptz [not null]
  locale text [not null, default: 'ko-KR']
  region_code text [not null, default: 'KR-00', note: 'KR-00 or one of the 17 coarse Korean region codes.']
  request_count bigint [not null, default: 0]
  fallback_count bigint [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (bucket_started_at, locale, region_code) [pk]
    (locale, bucket_started_at, region_code)
  }

  Note: 'Anonymous 15-minute API outcome counters. SQL enforces fallback_count <= request_count; health jobs use the ratio for automatic rollback.'
}

Table seasonal_ranking_models {
