  step_results jsonb [not null, default: '{}']
  source_usage jsonb [not null, default: '{}']
  bedrock_invocation_count smallint [not null, default: 0, note: 'Hard limit: 0..1 per orchestrator run.']
  bedrock_input_tokens integer [not null, default: 0]
  bedrock_output_tokens integer [not null, default: 0]
  estimated_cost_usd decimal(12,6) [not null, default: 0]
  error_code text
  error_message text
