  media_id uuid [not null]
  sort_order integer [not null, note: '0..9']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (message_id, media_id) [unique]
    (message_id, sort_order) [unique]
    (message_id, sort_order)
  }

  Note: 'Ordered media attachments for persisted consulting messages.'
}

Table consulting_membership_plans {
  id text [pk]
  name text [not null]
  tagline text [not null, default: '']
  price_per_month integer [not null]
  original_price_per_month integer
  benefits text[] [not null, default: '{}']
  badge text
  highlight boolean [not null, default: false]
  sort_order integer [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table user_consulting_memberships {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  plan_id text [not null]
  status text [not null, default: 'active']
  started_at timestamptz [not null, default: `now()`]
  current_period_end timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, status)
  }
}

Table consulting_payments {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  kind text [not null]
  option_id text
  booking_id uuid
  membership_id uuid
  amount integer [not null, default: 0]
  currency text [not null, default: 'KRW']
  status text [not null, default: 'pending']
  method text
  pg_provider text
  pg_tx_id text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, created_at)
  }
}

Table user_consents {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  consent_type consent_type [not null]
  version text [not null]
  accepted boolean [not null]
  accepted_at timestamptz
  revoked_at timestamptz
  recorded_at timestamptz [not null, default: `clock_timestamp()`]
  metadata jsonb [not null, default: '{}']

  indexes {
    (user_id, consent_type, version)
    (user_id, consent_type, recorded_at)
  }

  Note: 'Privacy, camera analysis, AI processing, third-party AI, marketing consent history.'
}

Table data_deletion_requests {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  target_type text [not null]
  target_id uuid
  status job_status [not null, default: 'pending']
  requested_at timestamptz [not null, default: `now()`]
  completed_at timestamptz
  reason text

  indexes {
    (user_id, requested_at)
  }

  Note: 'Account/photo/report/feedback/filter/product-personalization deletion request tracking.'
}

Table audit_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  actor_user_id uuid
  action text [not null]
  entity_type text [not null]
  entity_id uuid
  metadata jsonb [not null, default: '{}']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (entity_type, entity_id)
    (actor_user_id, created_at)
  }

  Note: 'Operational audit trail for sensitive media and AI analysis data.'
}

