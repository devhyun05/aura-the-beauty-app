Project ai_ar_makeup_guide {
  database_type: 'PostgreSQL'
  Note: 'Backend integration v1 schema based on latest dev screens. Flexible AI/AR sections are stored as jsonb payloads.'
}

Enum auth_provider {
  google
  kakao
  naver
  apple
}

Enum gender_type {
  female
  male
  other
  unknown
}

Enum media_source_type {
  camera
  gallery
  seed
  generated
}

Enum capture_type {
  face_analysis
  makeup_feedback
  filter_extraction
  ar_try_on
  hair_analysis
}

Enum job_status {
  pending
  processing
  completed
  failed
  cancelled
}

Enum makeup_style_type {
  look
  filter
  recipe
}

Enum product_category {
  lip
  cheek
  shadow
  liner
  base
}

Enum filter_category {
  recommended
  trend
  personal_color
  popular
}

Enum face_part {
  all
  base
  eye
  lip
  contour
}

Enum consent_type {
  privacy_policy
  camera_analysis
  ai_processing
  third_party_ai
  marketing
}

Table users {
  id uuid [pk, default: `gen_random_uuid()`]
  auth_provider auth_provider
  oauth_sub text
  email citext
  name text
  nickname text [not null]
  phone text
  birth_date date
  gender gender_type [not null, default: 'unknown']
  interest text
  personal_color text
  skin_type text
  skin_tone text
  tags text[]
  avatar_media_id uuid
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (auth_provider, oauth_sub) [unique]
    (email)
  }

  Note: 'Login, MyPage, ProfileEdit. Beauty profile fields are kept here for v1 API simplicity.'
}

Table media_assets {
  id uuid [pk, default: `gen_random_uuid()`]
  owner_user_id uuid
  media_kind text [not null]
  source media_source_type [not null]
  bucket text
  object_key text
  cdn_url text
  content_type text
  byte_size bigint
  width integer
  height integer
  checksum_sha256 text
  original_filename text
  is_original boolean [not null, default: true]
  status text [not null, default: 'active']
  created_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (bucket, object_key) [unique]
    (owner_user_id, created_at)
  }

  Note: 'S3/CDN metadata for avatar, capture, analysis, product, look, AR preview images.'
}

Table media_upload_sessions {
  id uuid [pk]
  owner_user_id uuid
  partner_account_id uuid
  media_kind text [not null]
  source media_source_type [not null]
  bucket text [not null]
  object_key text [not null]
  cdn_url text
  content_type text [not null]
  expected_byte_size bigint
  width integer
  height integer
  original_filename text
  thumbnail_bucket text
  thumbnail_object_key text
  thumbnail_cdn_url text
  thumbnail_content_type text
  thumbnail_expected_byte_size bigint
  thumbnail_width integer
  thumbnail_height integer
  status text [not null, default: 'pending', note: 'pending | completed | expired']
  media_asset_id uuid
  expires_at timestamptz [not null]
  completed_at timestamptz
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (bucket, object_key) [unique]
    (thumbnail_bucket, thumbnail_object_key) [unique]
    (owner_user_id, status, expires_at)
    (partner_account_id, status, expires_at)
    (expires_at)
  }

  Note: 'Server-issued, principal-bound S3 upload locations consumed exactly once.'
}

Table photo_captures {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  media_id uuid [not null]
  capture_type capture_type [not null]
  source media_source_type [not null]
  status job_status [not null, default: 'pending']
  captured_at timestamptz [not null, default: `now()`]
  device_payload jsonb [not null, default: '{}']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, capture_type, created_at)
  }

  Note: 'A single uploaded/captured image can feed analysis, feedback, filter extraction, or AR try-on.'
}

Table analysis_reports {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  photo_capture_id uuid
  source_media_id uuid
  preview_media_id uuid
  status job_status [not null, default: 'completed']
  ai_provider text
  ai_model text
  request_id text
  error_message text
  analyzed_at timestamptz
  title text [not null]
  report_title text [not null]
  environment_label text
  personal_color text
  face_shape text
  skin_type text
  tone_summary text
  recommended_mood text
  summary text
  short_summary text
  skin_analysis_summary text
  base_makeup_guide text
  tags text[]
  detail_payload jsonb [not null, default: '{}']
  embedding vector(1024)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, analyzed_at)
  }

  Note: 'ImageAnalysisReportsList and ImageAnalysisReportDetail. facePointGuide, recommendedMakeups, avoidedMakeups live in detail_payload.'
}

Table hair_analyses {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  client_request_id uuid [not null]
  photo_capture_id uuid
  source_media_id uuid [not null]
  mask_media_id uuid
  status text [not null, default: 'queued', note: 'queued | processing | completed | failed | expired']
  analysis_payload jsonb [not null, default: '{}']
  recommended_style_ids text[] [not null, default: '{}']
  error_code text
  error_message text
  attempt_count integer [not null, default: 0]
  expires_at timestamptz [not null]
  completed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, client_request_id) [unique]
    (user_id, created_at)
    (status, created_at)
    (expires_at)
  }
}

Table hair_simulations {
  id uuid [pk, default: `gen_random_uuid()`]
  analysis_id uuid [not null]
  user_id uuid [not null]
  client_request_id uuid [not null]
  style_id text [not null]
  status text [not null, default: 'queued', note: 'queued | processing | completed | failed | expired']
  result_media_id uuid
  provider text
  model text
  attempt_count integer [not null, default: 0]
  quality_attempt_count integer [not null, default: 0]
  quality_payload jsonb [not null, default: '{}']
  error_code text
  error_message text
  saved_at timestamptz
  expires_at timestamptz
  completed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, client_request_id) [unique]
    (analysis_id, style_id) [unique]
    (analysis_id, created_at)
    (user_id, created_at)
    (expires_at)
  }
}

Table saved_makeup_styles {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  style_type makeup_style_type [not null, default: 'look']
  source_analysis_report_id uuid
  source_filter_extraction_id uuid
  source_media_id uuid
  thumbnail_media_id uuid
  title text [not null]
  mood_label text
  short_description text
  tags text[]
  visibility text [not null, default: 'private']
  style_payload jsonb [not null, default: '{}']
  saved_at timestamptz [not null, default: `now()`]
  archived_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, saved_at)
    (source_analysis_report_id)
    (source_filter_extraction_id)
  }

  Note: 'MakeupStyleList plus saved filters and saved recipes from the filter extraction flow.'
}

Table products {
  id uuid [pk, default: `gen_random_uuid()`]
  external_key text [unique]
  brand_name text [not null]
  product_name text [not null]
  shade_name text
  category product_category [not null]
  price_krw integer [not null, default: 0]
  image_media_id uuid
  tags text[]
  palette text[]
  product_payload jsonb [not null, default: '{}']
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (category, is_active)
  }

  Note: 'ProductRecommendation and LikedProductList product catalog.'
}

Table user_product_likes {
  user_id uuid [not null]
  product_id uuid [not null]
  liked_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, product_id) [pk]
    (user_id, liked_at)
  }

  Note: 'LikedProductList and product heart state.'
}

Table auradin_search_sessions {
  session_id text [pk]
  state jsonb [not null]
  expires_at timestamptz [not null]
  updated_at timestamptz [not null]

  indexes {
    expires_at
  }

  Note: 'Temporary Auradin conversation state. Product likes remain in user_product_likes.'
}

Table product_recommendation_runs {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  source_analysis_report_id uuid
  user_nickname text
  look_title text
  look_description text
  look_media_id uuid
  product_ids uuid[]
  recommendation_payload jsonb [not null, default: '{}']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, created_at)
    (source_analysis_report_id)
  }

  Note: 'ProductRecommendationData. tabs, products, sets, matchRate, reason are kept in recommendation_payload for v1 API flexibility.'
}

Table ar_filters {
  id uuid [pk, default: `gen_random_uuid()`]
  external_key text [unique]
  category filter_category [not null]
  title text [not null]
  subtitle text
  intensity_label text
  preview_media_id uuid
  source_analysis_report_id uuid
  source_filter_extraction_id uuid
  filter_payload jsonb [not null, default: '{}']
  is_public boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (category, is_public)
  }

  Note: 'ARMakeupGuideData. facePartIds, colorOptions, typeOptions, textureOptions are stored in filter_payload.'
}

Table user_ar_filter_states {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  filter_id uuid [not null]
  selected_face_part face_part
  selected_color_id text
  selected_type_id text
  selected_texture_id text
  guide_mode text
  comparison_mode text
  is_overlay_visible boolean [not null, default: true]
  landmarks jsonb [not null, default: '[]']
  adjustments jsonb [not null, default: '{}']
  saved_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, created_at)
  }

  Note: 'ARFilterLocation and ARFilterStyle current/saved customization state.'
}

Table filter_extraction_reports {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  photo_capture_id uuid
  result_media_id uuid
  status job_status [not null, default: 'completed']
  title text [not null]
  subtitle text
  tags text[]
  accuracy integer
  model_version text
  result_payload jsonb [not null, default: '{}']
  created_at timestamptz [not null, default: `now()`]
  completed_at timestamptz

  indexes {
    (user_id, created_at)
  }

  Note: 'FilterUpload/Loading/Result/TryOn/Save/RecipeDetail. palette, points, loadingSteps, recipeItems live in result_payload.'
}

Table makeup_feedback_reports {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  photo_capture_id uuid
  uploaded_media_id uuid
  source media_source_type [not null]
  source_label text
  score integer
  status job_status [not null, default: 'completed']
  model_version text
  feedback_payload jsonb [not null, default: '{}']
  created_at timestamptz [not null, default: `now()`]
  completed_at timestamptz

  indexes {
    (user_id, created_at)
  }

  Note: 'FeedbackResult/Guide/Tip. summaryBadges, callouts, points, strengths live in feedback_payload.'
}

Table home_hero_banners {
  id uuid [pk, default: `gen_random_uuid()`]
  eyebrow text
  title text [not null]
  description text
  image_media_id uuid
  cta_label text
  cta_target text
  is_active boolean [not null, default: true]
  sort_order integer [not null, default: 0]
  starts_at timestamptz
  ends_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (is_active, sort_order)
  }

  Note: 'HomeData.hero. Controls the main carousel headline, copy, CTA, and fallback image.'
}

Table home_notices {
  id uuid [pk, default: `gen_random_uuid()`]
  hero_banner_id uuid
  title text [not null]
  description text [not null]
  is_active boolean [not null, default: true]
  sort_order integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (hero_banner_id, sort_order)
    (is_active, sort_order)
  }

  Note: 'HomeData.hero.notices. Announcement rows attached to the home hero.'
}

Table home_trend_items {
  id uuid [pk, default: `gen_random_uuid()`]
  hero_banner_id uuid
  target_style_id uuid
  title text [not null]
  tone text
  image_media_id uuid
  target_payload jsonb [not null, default: '{}']
  is_active boolean [not null, default: true]
  sort_order integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (hero_banner_id, sort_order)
    (is_active, sort_order)
  }

  Note: 'HomeData.hero.trends. Weekly trend carousel cards.'
}

Table home_filter_store_items {
  id uuid [pk, default: `gen_random_uuid()`]
  title text [not null]
  description text [not null]
  category text [not null]
  image_media_id uuid
  product_id uuid
  ar_filter_id uuid
  target_payload jsonb [not null, default: '{}']
  is_active boolean [not null, default: true]
  sort_order integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (category, is_active)
    (is_active, sort_order)
  }

  Note: 'HomeData.filterStore. Home filter store cards can point to product catalog or AR filter catalog.'
}

Table home_recommended_looks {
  id uuid [pk, default: `gen_random_uuid()`]
  saved_makeup_style_id uuid
  title text [not null]
  description text [not null]
  display_date date
  image_media_id uuid
  target_payload jsonb [not null, default: '{}']
  is_active boolean [not null, default: true]
  sort_order integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (is_active, sort_order)
    (display_date)
  }

  Note: 'HomeData.recommendedLooks. Home recommended makeup look cards.'
}
Table community_threads {
  id uuid [pk, default: `gen_random_uuid()`]
  author_user_id uuid [not null]
  category text [not null, note: 'lookbook | question | product_combo | before_after']
  title text [not null]
  body text [not null, default: '']
  mood_tags text[] [not null, default: '{}']
  situation_tags text[] [not null, default: '{}']
  difficulty text [note: 'easy | medium | hard']
  duration_minutes integer
  product_usage jsonb [not null, default: '{"base": [], "eye": [], "cheek": [], "lip": []}']
  like_count integer [not null, default: 0]
  reply_count integer [not null, default: 0]
  save_count integer [not null, default: 0]
  view_count integer [not null, default: 0]
  status text [not null, default: 'active']
  embedding vector(1024)
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (category, created_at)
    ((like_count + save_count * 2 + reply_count), created_at)
    (title)
    (body)
  }

  Note: 'Look-first community feed posts. Trending is derived by sort, not stored.'
}

Table community_thread_media {
  id uuid [pk, default: `gen_random_uuid()`]
  thread_id uuid [not null]
  media_id uuid [not null]
  sort_order integer [not null, note: '0..3; 0 is cover']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (thread_id, media_id) [unique]
    (thread_id, sort_order) [unique]
    (thread_id, sort_order)
  }

  Note: 'Ordered 1-4 images for a community thread.'
}

Table community_replies {
  id uuid [pk, default: `gen_random_uuid()`]
  thread_id uuid [not null]
  parent_reply_id uuid
  author_user_id uuid [not null]
  body text [not null]
  like_count integer [not null, default: 0]
  status text [not null, default: 'active']
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (thread_id, created_at)
  }

  Note: 'Thread replies with one-level nesting enforced by API.'
}

Table community_thread_likes {
  user_id uuid [not null]
  thread_id uuid [not null]
  liked_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, thread_id) [pk]
    (thread_id, liked_at)
  }
}

Table community_thread_saves {
  user_id uuid [not null]
  thread_id uuid [not null]
  saved_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, thread_id) [pk]
    (thread_id, saved_at)
  }
}

Table community_reply_likes {
  user_id uuid [not null]
  reply_id uuid [not null]
  liked_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, reply_id) [pk]
    (reply_id)
  }
}

Table community_reports {
  id uuid [pk, default: `gen_random_uuid()`]
  reporter_user_id uuid [not null]
  target_type text [not null, note: 'thread | reply']
  target_thread_id uuid
  target_reply_id uuid
  reason text [not null, note: 'spam | abuse | privacy | other']
  detail text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (reporter_user_id, target_thread_id) [unique]
    (reporter_user_id, target_reply_id) [unique]
    (target_thread_id)
    (target_reply_id)
  }

  Note: 'Duplicate-safe moderation reports for threads and replies.'
}
Table community_events {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  thread_id uuid
  event_type text [not null, note: 'impression | view | revisit | dwell | like | save | reply | slider | search']
  search_query text
  dwell_ms integer
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, created_at)
  }

  Note: 'Behavior events for community recommendation signals.'
}

Table consulting_categories {
  id text [pk]
  title text [not null]
  description text [not null, default: '']
  icon text [not null]
  sort_order integer [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table consulting_experts {
  id text [pk]
  name text [not null]
  title text [not null]
  signature_line text [not null, default: '']
  initials text [not null]
  avatar_tone text [not null, default: 'rose']
  image_url text
  studio_name text
  career_years integer [not null, default: 0]
  rating numeric(2,1) [not null, default: 0]
  review_count integer [not null, default: 0]
  session_count integer [not null, default: 0]
  rebook_rate integer [not null, default: 0]
  response_minutes integer [not null, default: 0]
  intro text [not null, default: '']
  availability_note text
  operating_hours jsonb
  holiday_dates jsonb
  booking_open_months integer [not null, default: 1]
  tags text[] [not null, default: '{}']
  certifications text[] [not null, default: '{}']
  is_active boolean [not null, default: true]
  sort_order integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table consulting_expert_categories {
  expert_id text [not null]
  category_id text [not null]

  indexes {
    (expert_id, category_id) [pk]
    (category_id)
  }
}

Table consulting_expert_durations {
  id uuid [pk, default: `gen_random_uuid()`]
  expert_id text [not null]
  code text [not null]
  label text [not null]
  minutes integer [not null]
  price integer [not null]
  description text [not null, default: '']
  recommended boolean [not null, default: false]
  sort_order integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (expert_id, code) [unique]
    (expert_id, sort_order)
  }
}

Table consulting_expert_career {
  id uuid [pk, default: `gen_random_uuid()`]
  expert_id text [not null]
  code text [not null]
  period text [not null]
  role text [not null]
  sort_order integer [not null, default: 0]

  indexes {
    (expert_id, code) [unique]
    (expert_id, sort_order)
  }
}

Table consulting_expert_reviews {
  id text [pk]
  expert_id text [not null]
  booking_id uuid
  author text [not null]
  author_user_id uuid
  category text [not null, default: '']
  body text [not null]
  rating integer [not null, default: 5]
  date_label text
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (expert_id, created_at)
    (booking_id) [unique]
  }
}

Table consulting_bookings {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  expert_id text [not null]
  duration_code text
  duration_label text
  duration_minutes integer
  category_label text
  scheduled_at timestamptz
  scheduled_date date
  slot_start_minutes integer
  date_label text
  slot_id text
  concern_id text
  concern_label text
  share_reports boolean [not null, default: false]
  shared_report_ids uuid[] [not null, default: '{}']
  question text
  contact_name text
  contact_phone text
  preferred_contact_method text
  session_mode text [not null, default: 'online', note: 'online | offline']
  operator_note text
  confirmed_at timestamptz
  expert_read_at timestamptz
  status text [not null, default: 'requested', note: 'requested | contacting | confirmed | scheduled | in_progress | unavailable | completed | canceled']
  price integer [not null, default: 0]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, status, created_at)
    (expert_id)
  }
}

Table consulting_summaries {
  id uuid [pk, default: `gen_random_uuid()`]
  booking_id uuid [not null, unique]
  expert_id text [not null]
  duration_label text
  date_label text
  notes jsonb [not null, default: '[]']
  products jsonb [not null, default: '[]']
  created_at timestamptz [not null, default: `now()`]
}

Table consulting_call_sessions {
  id uuid [pk, default: `gen_random_uuid()`]
  booking_id uuid [not null, unique]
  user_id uuid [not null]
  expert_id text [not null]
  provider text [not null, default: 'chime']
  provider_meeting_id text
  provider_external_meeting_id text
  control_region text [not null, default: 'ap-northeast-2']
  media_region text
  status text [not null, default: 'created', note: 'created | active | ended | failed']
  started_at timestamptz
  ended_at timestamptz
  expires_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (booking_id) [unique]
    (expert_id, status, created_at)
  }

  Note: 'Amazon Chime meeting sessions for confirmed online consulting bookings.'
}

Table consulting_messages {
  id uuid [pk, default: `gen_random_uuid()`]
  booking_id uuid [not null]
  client_message_id text [not null]
  sender_type text [not null, note: 'user | expert | operator | system']
  sender_user_id uuid
  sender_name text [not null, default: '']
  body text [not null, default: '']
  created_at timestamptz [not null, default: `now()`]
  deleted_at timestamptz

  indexes {
    (booking_id, sender_type, client_message_id) [unique]
    (booking_id, created_at)
  }

  Note: 'Persisted WebSocket chat messages for a consulting booking.'
}

Table consulting_partner_accounts {
  id uuid [pk, default: `gen_random_uuid()`]
  expert_id text [not null]
  email citext [not null, unique]
  password_hash text [not null]
  password_salt text [not null]
  role text [not null, default: 'expert', note: 'expert | business_manager | operator']
  workspace_scope text [not null, default: 'expert_personal', note: 'expert_personal | business_operations']
  status text [not null, default: 'active', note: 'invited | active | suspended']
  password_change_required boolean [not null, default: false]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (expert_id)
  }

  Note: 'Partner workspace login accounts issued for consulting experts.'
}

Table consulting_partner_sessions {
  token_hash text [pk]
  account_id uuid [not null]
  expires_at timestamptz [not null]
  created_at timestamptz [not null, default: `now()`]
  last_seen_at timestamptz

  indexes {
    (account_id, expires_at)
  }

  Note: 'Hashed partner workspace session tokens for consulting-web.'
}

Table consulting_partner_applications {
  id uuid [pk, default: `gen_random_uuid()`]
  email citext [not null]
  name text [not null]
  title text [not null]
  studio_name text
  phone text
  message text
  status text [not null, default: 'submitted', note: 'submitted | needs_update | approved | rejected']
  expert_id text
  rejection_reason text
  reviewed_by_subject text
  reviewed_at timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (email) [unique, note: 'Partial unique index for submitted/needs_update statuses']
  }

  Note: 'Consultant signup applications reviewed by Cognito admin/operator users.'
}

Table consulting_message_media {
  id uuid [pk, default: `gen_random_uuid()`]
  message_id uuid [not null]
  media_id uuid [not null]
  sort_order integer [not null, note: '0..9']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (message_id, media_id) [unique]
    (message_id, sort_order) [unique]
    (message_id, sort_order)
  }

  Note: 'Ordered media attachments for persisted consulting messages.'
}

Table consulting_membership_plans {
  id text [pk]
  name text [not null]
  tagline text [not null, default: '']
  price_per_month integer [not null]
  original_price_per_month integer
  benefits text[] [not null, default: '{}']
  badge text
  highlight boolean [not null, default: false]
  sort_order integer [not null, default: 0]
  is_active boolean [not null, default: true]
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]
}

Table user_consulting_memberships {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  plan_id text [not null]
  status text [not null, default: 'active']
  started_at timestamptz [not null, default: `now()`]
  current_period_end timestamptz
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, status)
  }
}

Table consulting_payments {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  kind text [not null]
  option_id text
  booking_id uuid
  membership_id uuid
  amount integer [not null, default: 0]
  currency text [not null, default: 'KRW']
  status text [not null, default: 'pending']
  method text
  pg_provider text
  pg_tx_id text
  created_at timestamptz [not null, default: `now()`]
  updated_at timestamptz [not null, default: `now()`]

  indexes {
    (user_id, created_at)
  }
}

Table user_consents {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  consent_type consent_type [not null]
  version text [not null]
  accepted boolean [not null]
  accepted_at timestamptz
  revoked_at timestamptz
  metadata jsonb [not null, default: '{}']

  indexes {
    (user_id, consent_type, version)
  }

  Note: 'Privacy, camera analysis, AI processing, third-party AI, marketing consent history.'
}

Table data_deletion_requests {
  id uuid [pk, default: `gen_random_uuid()`]
  user_id uuid [not null]
  target_type text [not null]
  target_id uuid
  status job_status [not null, default: 'pending']
  requested_at timestamptz [not null, default: `now()`]
  completed_at timestamptz
  reason text

  indexes {
    (user_id, requested_at)
  }

  Note: 'Account/photo/report/feedback/filter deletion request tracking.'
}

Table audit_logs {
  id uuid [pk, default: `gen_random_uuid()`]
  actor_user_id uuid
  action text [not null]
  entity_type text [not null]
  entity_id uuid
  metadata jsonb [not null, default: '{}']
  created_at timestamptz [not null, default: `now()`]

  indexes {
    (entity_type, entity_id)
    (actor_user_id, created_at)
  }

  Note: 'Operational audit trail for sensitive media and AI analysis data.'
}

