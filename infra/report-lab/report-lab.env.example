# Generated runtime values live in .runtime/report-lab.env and are never committed.
AURA_REPORT_LAB_DB_PASSWORD=
AURA_REPORT_LAB_DB_PORT=55432
AURA_REPORT_LAB_DATABASE_URL=
AURA_REPORT_LAB_DB_ENGINE=native

# Report Lab is local-only and deterministic by default.
LAB_MODE=true
ENVIRONMENT=local
AUTH_REQUIRED=false
REPORT_LAB_MODEL_PROVIDER=disabled
IMAGE_GENERATION_PROVIDER=disabled
AI_PROVIDER=disabled
OPENAI_ENABLED=false
CORS_ENABLED=true
CORS_ALLOW_ORIGINS=http://127.0.0.1:5173
REPORT_LAB_MAX_RUNS_PER_REQUEST=5
REPORT_LAB_SESSION_BUDGET_RUNS=50
REPORT_LAB_RETENTION_DAYS=7
REPORT_LAB_FIXTURE_PRINCIPAL_ID=00000000-0000-4000-8000-000000000027
REPORT_LAB_RAW_RESPONSE_ADMIN_TOKEN=
